  "constraints": [
    {
      "definition": "CHECK ((evolves_from_id IS DISTINCT FROM id))",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_cannot_evolve_from_itself"
    },
    {
      "definition": "FOREIGN KEY (evolves_from_id) REFERENCES pokemon(id) ON DELETE RESTRICT",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_evolves_from_id_fkey"
    },
    {
      "definition": "UNIQUE (name)",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_name_key"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_pkey"
    },
    {
      "definition": "CHECK ((pokeapi_id > 0))",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_pokeapi_id_check"
    },
    {
      "definition": "UNIQUE (pokeapi_id)",
      "table_name": "pokemon",
      "convalidated": true,
      "constraint_name": "pokemon_pokeapi_id_key"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_pkey"
    },
    {
      "definition": "FOREIGN KEY (reward_pokemon_id) REFERENCES pokemon(id) ON DELETE RESTRICT",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_reward_pokemon_id_fkey"
    },
    {
      "definition": "CHECK ((reward_type = ANY (ARRAY['pokemon'::text, 'xp'::text])))",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_reward_type_check"
    },
    {
      "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_user_id_fkey"
    },
    {
      "definition": "CHECK ((xp_awarded >= 0))",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_xp_awarded_check"
    },
    {
      "definition": "FOREIGN KEY (xp_recipient_id) REFERENCES user_pokemon(id) ON DELETE RESTRICT",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "user_packs_xp_recipient_id_fkey"
    },
    {
      "definition": "CHECK (((opened_at IS NULL) OR (opened_at >= earned_at)))",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "valid_pack_opening_time"
    },
    {
      "definition": "CHECK ((((opened_at IS NULL) AND (reward_type IS NULL) AND (reward_pokemon_id IS NULL) AND (xp_awarded = 0) AND (xp_recipient_id IS NULL)) OR ((opened_at IS NOT NULL) AND (reward_type IS NOT NULL) AND (reward_type = 'pokemon'::text) AND (reward_pokemon_id IS NOT NULL) AND (xp_awarded = 0) AND (xp_recipient_id IS NULL)) OR ((opened_at IS NOT NULL) AND (reward_type IS NOT NULL) AND (reward_type = 'xp'::text) AND (reward_pokemon_id IS NULL) AND (xp_awarded > 0) AND (xp_recipient_id IS NOT NULL))))",
      "table_name": "user_packs",
      "convalidated": true,
      "constraint_name": "valid_pack_reward"
    },
    {
      "definition": "CHECK ((level >= 1))",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_level_check"
    },
    {
      "definition": "PRIMARY KEY (id)",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_pkey"
    },
    {
      "definition": "FOREIGN KEY (pokemon_id) REFERENCES pokemon(id) ON DELETE RESTRICT",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_pokemon_id_fkey"
    },
    {
      "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_user_id_fkey"
    },
    {
      "definition": "UNIQUE (user_id, pokemon_id)",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_user_id_pokemon_id_key"
    },
    {
      "definition": "CHECK ((xp >= 0))",
      "table_name": "user_pokemon",
      "convalidated": true,
      "constraint_name": "user_pokemon_xp_check"
    }
